rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection probe document
    match /test/connection {
      allow read: if true;
    }

    // Users collection: user profiles and gamification stats
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Classrooms collection
    match /classrooms/{classroomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(classroomId);
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }
  }
}
